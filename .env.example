# AI-agent setlist-import configuration. Copy these entries into the ignored
# .env file; do not commit either the credentials file or its content.

# The ID from the Google Sheet URL: /spreadsheets/d/<this-value>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Absolute or workspace-relative path to an untracked Google service-account
# JSON key. Enable Google Sheets API and share the Sheet with that service
# account's client_email as an Editor.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./google-service-account.json

# Optional. The agent uses these defaults when the variables are blank.
POCKET_BACKBEAT_SONGS_SHEET=Songs
POCKET_BACKBEAT_PLAYLISTS_SHEET=Playlists
